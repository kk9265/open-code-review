diff --git a/tests/backend/test_incremental_graph_fidelity.py b/tests/backend/test_incremental_graph_fidelity.py
new file mode 100644
--- /dev/null
+++ b/tests/backend/test_incremental_graph_fidelity.py
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: MIT
+from dataclasses import asdict, replace
+from pathlib import Path
+
+import pytest
+
+from backend.app.database import SQLiteStore
+from backend.app.services.analyzer import AnalysisService
+from backend.app.services.graph import CodeGraphNode
+from backend.app.services.graphrag.context import node_payload
+from backend.app.services.incremental import IncrementalUpdater
+from backend.app.services.repo_scanner import RepoScanner
+
+
+def test_parser_cache_is_not_included_in_model_context() -> None:
+    node = CodeGraphNode(
+        id="file",
+        repo_id="repo",
+        type="file",
+        name="service.py",
+        metadata={"ast_symbols": [{"calls": ["secret_internal_cache"]}], "is_source": True},
+    )
+    payload = node_payload(node, 1.0, [], hop=0)
+    assert payload["metadata"] == {"is_source": True}
+    assert "ast_symbols" in node.metadata
+
+
+def assert_matches_full(store: SQLiteStore, repo_id: str, path: Path) -> None:
+    actual = store.get_graph(repo_id)
+    full = AnalysisService(store=store).build_graph_for_path(str(path))
+    for incremental, expected in zip(actual, [full.nodes, full.edges], strict=True):
+        assert {item.id: asdict(item) for item in incremental} == {
+            item.id: asdict(item) for item in expected
+        }
+
+
+@pytest.mark.parametrize(
+    ("name", "source"),
+    [
+        (
+            "service.go",
+            """package service
+import "os"
+type Config struct { Value string }
+type Reader interface { Read() string }
+type Client struct { Config Config }
+func (c *Client) Read() string { return os.Getenv("VALUE") }
+func New(c Config) *Client { return &Client{Config: c} }
+""",
+        ),
+        (
+            "service.py",
+            """import os
+class Config:
+    pass
+class Client(Config):
+    def read(self):
+        return os.getenv("VALUE")
+def make() -> Client:
+    return Client()
+""",
+        ),
+        (
+            "service.ts",
+            """import { Config } from './config';
+interface Reader { read(): string; }
+class Client implements Reader {
+    read(): string { return Config.value; }
+}
+export function make(): Reader { return new Client(); }
+""",
+        ),
+    ],
+)
+def test_incremental_graph_matches_full(
+    tmp_path: Path,
+    name: str,
+    source: str,
+) -> None:
+    path = tmp_path / "repo"
+    path.mkdir()
+    (path / name).write_text(source, encoding="utf-8")
+    (path / "config.ts").write_text(
+        'export class Config { static value = "ok"; }', encoding="utf-8"
+    )
+    (path / "change.py").write_text("def answer():\n    return 1\n", encoding="utf-8")
+    (path / "go.mod").write_text("module example\n", encoding="utf-8")
+    store = SQLiteStore(tmp_path / "graph.sqlite3")
+    repo = store.upsert_repo(RepoScanner().describe(str(path)))
+    AnalysisService(store=store).analyze(repo.id)
+
+    updater = IncrementalUpdater(store=store)
+    for _ in range(2):
+        result = updater.update(repo.id, refresh_chunks=False)
+        assert result.plan.affected_files == []
+        assert result.parsed_file_count == 0
+        assert_matches_full(store, repo.id, path)
+
+    (path / "change.py").write_text("def answer():\n    return 2\n", encoding="utf-8")
+    result = updater.update(repo.id, refresh_chunks=False)
+    assert result.parsed_file_count == 1
+    assert result.plan.changed_files == ["change.py"]
+    assert_matches_full(store, repo.id, path)
+
+    (path / "go.mod").write_text("module changed\n", encoding="utf-8")
+    result = updater.update(repo.id, refresh_chunks=False)
+    assert result.plan.changed_files == ["go.mod"]
+    assert result.parsed_file_count == 0
+    assert_matches_full(store, repo.id, path)
+
+    (path / "config.ts").unlink()
+    (path / "new.py").write_text("def added():\n    return 3\n", encoding="utf-8")
+    result = updater.update(repo.id, refresh_chunks=False)
+    assert result.plan.deleted_files == ["config.ts"]
+    assert result.plan.new_files == ["new.py"]
+    assert result.parsed_file_count == 1
+    assert_matches_full(store, repo.id, path)
+
+
+@pytest.mark.parametrize("changed", [False, True])
+@pytest.mark.parametrize("entrypoint", ["analyze", "update"])
+def test_legacy_graph_reparses_instead_of_losing_relationships(
+    tmp_path: Path,
+    changed: bool,
+    entrypoint: str,
+) -> None:
+    path = tmp_path / "repo"
+    path.mkdir()
+    (path / "service.py").write_text(
+        "class Config:\n    pass\ndef make() -> Config:\n    return Config()\n", encoding="utf-8"
+    )
+    (path / "change.py").write_text("def answer():\n    return 1\n", encoding="utf-8")
+    store = SQLiteStore(tmp_path / "graph.sqlite3")
+    repo = store.upsert_repo(RepoScanner().describe(str(path)))
+    AnalysisService(store=store).analyze(repo.id)
+    nodes, edges = store.get_graph(repo.id)
+    nodes = [
+        replace(node, metadata={k: v for k, v in node.metadata.items() if k != "ast_symbols"})
+        for node in nodes
+    ]
+    store.replace_graph(repo.id, nodes=nodes, edges=[e for e in edges if e.type != "references"])
+    if changed:
+        (path / "change.py").write_text("def answer():\n    return 2\n", encoding="utf-8")
+    service = (
+        AnalysisService(store=store) if entrypoint == "analyze" else IncrementalUpdater(store=store)
+    )
+    result = (
+        service.analyze(repo.id)
+        if entrypoint == "analyze"
+        else service.update(repo.id, refresh_chunks=False)
+    )
+    assert result.parsed_file_count == 2
+    assert result.reused_file_count == 0
+    assert_matches_full(store, repo.id, path)
+    result = (
+        service.analyze(repo.id)
+        if entrypoint == "analyze"
+        else service.update(repo.id, refresh_chunks=False)
+    )
+    assert result.parsed_file_count == 0
